# Cyber Threat Visualizer - Environment Configuration
# Copy this file to .env and modify as needed

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Sniffer Configuration
# Leave empty for auto-detect, or specify interface name (e.g., eth0, ens33, \Device\NPF_{GUID})
SNIFFER_INTERFACE=
SNIFFER_BPF_FILTER=ip
SNIFFER_PACKET_BUFFER_SIZE=10000

# Feature Extraction
FEATURE_WINDOW_SECONDS=60
FEATURE_MIN_PACKETS=10

# ML Model
ML_MODEL_PATH=./ml/models/anomaly_detector.pkl
ML_CONTAMINATION=0.001
ML_N_ESTIMATORS=100
ML_MAX_SAMPLES=auto
ML_RETRAIN_INTERVAL_HOURS=24

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend
FRONTEND_URL=http://localhost:3000

# GeoIP
GEOIP_CACHE_TTL=86400
GEOIP_API_URL=http://ip-api.com/json/
GEOIP_RATE_LIMIT=45

# Redis Channels
CHANNEL_RAW_PACKETS=network:raw
CHANNEL_FEATURES=network:features
CHANNEL_THREATS=network:threats
CHANNEL_STATS=network:stats

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s